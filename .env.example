# Copy to .env and fill in. .env is gitignored here AND in every project
# `bgate init` stamps out -- see templates/shared/.gitignore for why that
# second one matters.

# Image generation. At least one is needed for the art seat to do anything.
OPENAI_API_KEY=
KREA_API_KEY=

# Optional: where the dashboard and MCP tools look for the game project.
# Every tool also takes an explicit project_dir, which wins over this.
# BGATE_ROOT=C:\path\to\your\game\project

# Optional: skip the dashboard's token auth. Localhost-only development
# convenience -- never set this on a machine reachable from a network.
# BGATE_NO_AUTH=1
